{
  "name": "@armache/storefront",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "sync:contract": "aws s3 cp s3://armache-contracts/storefront/latest/spec.yaml /tmp/storefront-spec.yaml && ./node_modules/.bin/armache-sync-contract --spec /tmp/storefront-spec.yaml --contract storefront --output src/types/api.ts",
    "prebuild": "bash scripts/ci-contract-guard.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@armachecafe/openapi-client": "^2.1.1",
    "aws-amplify": "6.6.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.408.0",
    "next": "14.2.5",
    "openapi-fetch": "0.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.45.3",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
