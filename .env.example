# ============================================
# Storefront Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# --- Cognito (Customers Pool) ---
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_jw3PdJZAN
NEXT_PUBLIC_COGNITO_CLIENT_ID=your-cognito-app-client-id-here

# --- API Gateway ---
NEXT_PUBLIC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# --- Culqi (Payment Gateway) ---
NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
